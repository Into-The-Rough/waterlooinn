# This file documents the deployment environment. The app does not load it
# automatically; configure these values in the host's secret/environment store.
NODE_ENV=production
BOOKING_HOST=127.0.0.1
BOOKING_PORT=8888
BOOKING_PUBLIC_URL=https://waterlooinnbiggin.com
BOOKING_TRUST_PROXY=true

# Store both values as secrets. Use a unique password of at least 20 characters.
BOOKING_ADMIN_USERNAME=Waterloo Inn manager
BOOKING_ADMIN_PASSWORD=replace-in-secret-store
RESEND_API_KEY=replace-in-secret-store

BOOKING_FROM_EMAIL=bookings@waterlooinnbiggin.com
BOOKING_STAFF_EMAIL=waterlooinn417@gmail.com

# These must be persistent paths outside an ephemeral application image.
BOOKING_DATABASE_PATH=/var/lib/waterloo-bookings/booking-diary.sqlite
BOOKING_BACKUP_DIRECTORY=/var/backups/waterloo-bookings
BOOKING_BACKUP_RETENTION_DAYS=30

# Generate with: openssl rand -base64 32
# Keep this key in the secret store and separately from the backup files.
BOOKING_BACKUP_KEY=replace-in-secret-store
