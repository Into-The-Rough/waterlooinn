# This file documents local and deployment settings. The app does not load it
# automatically; configure deployment values in Netlify's environment store.
BOOKING_HOST=127.0.0.1
BOOKING_PORT=8888
BOOKING_PUBLIC_URL=https://waterlooinnbiggin.com

# Reuse the site's invite-only Netlify Identity. Optionally require one or more
# comma-separated Identity roles; blank matches the existing invited-user policy.
BOOKING_IDENTITY_URL=https://waterlooinnbiggin.com/.netlify/identity
BOOKING_ADMIN_ROLES=

# Signs the short-lived HTTP-only customer manage-session cookie. Generate a
# different random value for each environment with: openssl rand -base64 32
BOOKING_SESSION_SECRET=replace-in-secret-store

# Store the email-provider credential as a secret.
RESEND_API_KEY=replace-in-secret-store

BOOKING_FROM_EMAIL=bookings@waterlooinnbiggin.com
BOOKING_STAFF_EMAIL=waterlooinn417@gmail.com

# Netlify Database supplies NETLIFY_DB_URL automatically. Do not create or
# commit this value yourself.
NETLIFY_DB_URL=managed-by-netlify-database

# The standalone local server continues to use SQLite and these optional local
# paths. Netlify Functions do not use them.
BOOKING_DATABASE_PATH=.local/booking-diary.sqlite
BOOKING_BACKUP_DIRECTORY=.local/backups
BOOKING_BACKUP_RETENTION_DAYS=30

# Generate with: openssl rand -base64 32
# Keep this key in the secret store and separately from the backup files.
BOOKING_BACKUP_KEY=replace-in-secret-store
