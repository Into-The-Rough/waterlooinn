layout: false
permalink: /admin/bookings/login/
---
<!DOCTYPE html>
<html lang="en" data-identity-url="{{ site.url }}/.netlify/identity">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Booking Diary Sign In | {{ site.name }}</title>
    <meta name="robots" content="noindex,nofollow">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="stylesheet" href="/css/booking-admin.css">
    <script src="/js/booking-identity-config.js" defer></script>
    <script src="https://identity.netlify.com/v1/netlify-identity-widget.js" defer></script>
    <script src="/js/booking-identity.js" defer></script>
</head>
<body class="admin-login-page">
    <main class="admin-login-shell">
        <section class="admin-login-card" data-admin-login>
            <p class="admin-eyebrow">The Waterloo Inn</p>
            <h1>Booking diary sign in</h1>
            <p>Sign in to manage table bookings, availability and the daily diary.</p>
            <div class="admin-login-error" role="alert" hidden></div>
            <form class="admin-login-form" data-password-login>
                <label>
                    <span>Username</span>
                    <input type="text" name="username" autocomplete="username" autocapitalize="none"
                        spellcheck="false" maxlength="128" required autofocus>
                </label>
                <label>
                    <span>Password</span>
                    <input type="password" name="password" autocomplete="current-password"
                        maxlength="1024" required>
                </label>
                <button type="submit" class="admin-button">Sign in</button>
                <small>Stay signed in on this device for 30 days.</small>
            </form>
            <div class="admin-login-fallback" data-identity-fallback>
                <span>Website administrator?</span>
                <button type="button" class="admin-button admin-button-secondary" data-identity-login>
                    Use Netlify Identity instead
                </button>
            </div>
        </section>
    </main>
    <script src="/js/booking-admin-login.js" defer></script>
</body>
</html>
